+static esp_err_t app_select_handler(httpd_req_t *request)
+{
+    if (require_auth(request) != ESP_OK) return ESP_FAIL;
+    if (request->content_len <= 0 || request->content_len > 64) {
+        return httpd_resp_send_err(request, HTTPD_400_BAD_REQUEST, "Invalid app request");
+    }
+    uint8_t *body = read_signed_body(request, 1);
+    if (!body) return httpd_resp_send_err(request, HTTPD_400_BAD_REQUEST, "App request does not match its signature");
+    body[request->content_len] = 0;
+    cJSON *json = cJSON_ParseWithLength((const char *)body, request->content_len + 1);
+    free(body);
+    const cJSON *app_item = json ? cJSON_GetObjectItemCaseSensitive(json, "app") : NULL;
+    int app_id = -1;
+    bool valid = cJSON_IsNumber(app_item) && app_item->valuedouble == app_item->valueint &&
+                 app_item->valueint >= 0 && app_item->valueint < BUDDY_APP_COUNT;
+    if (valid) app_id = app_item->valueint;
+    cJSON_Delete(json);
+    if (!valid) return httpd_resp_send_err(request, HTTPD_400_BAD_REQUEST, "Invalid app ID");
+    if (!board_lvgl_lock(1000)) {
+        return httpd_resp_send_err(request, HTTPD_500_INTERNAL_SERVER_ERROR, BT(BT_DISPLAY_BUSY));
+    }
+    bool selected = buddy_ui_select_app((buddy_app_t)app_id);
+    board_lvgl_unlock();
+    if (!selected) return httpd_resp_send_err(request, HTTPD_400_BAD_REQUEST, "App unavailable");
+    char reply[48];
+    snprintf(reply, sizeof(reply), "{\"ok\":true,\"app\":%d}", app_id);
+    httpd_resp_set_type(request, "application/json");
+    return httpd_resp_sendstr(request, reply);
+}
