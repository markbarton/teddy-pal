+static void refresh_amp_inbox(void)
+{
+    uint32_t waiting_count = 0;
+    if (music_connected() && ui.stats.codex.activity.available && !ui.stats.codex.activity.stale) {
+        for (uint32_t i = 0; i < ui.stats.codex.activity.item_count && i < BUDDY_CODEX_MAX_TASKS; ++i) {
+            if (strcmp(ui.stats.codex.activity.items[i].state, "waiting") == 0) {
+                ui.amp_card_item_idx[waiting_count++] = i;
+            }
+        }
+    }
+    ui.amp_waiting_count = waiting_count;
+
+    if (waiting_count == 0 && ui.amp_inbox_open) {
+        ui.amp_inbox_open = false;
+        if (ui.amp_inbox_page) visible(ui.amp_inbox_page, false);
+        refresh_display_power();
+    }
+
+    bool show_badge = waiting_count > 0 && !ui.amp_inbox_open && !ui.startup &&
+        ui.connection != BUDDY_PROVISIONING && !ui.alert_key[0] &&
+        ui.confirm_action == BUDDY_CONFIRM_NONE && ui.install_stage == BUDDY_INSTALL_NONE;
+    if (ui.amp_badge) {
+        visible(ui.amp_badge, show_badge);
+        if (show_badge) {
+            char btxt[12];
+            snprintf(btxt, sizeof(btxt), "%lu", (unsigned long)waiting_count);
+            set_label_if_changed(ui.amp_badge_label, btxt);
+            place_amp_badge();
+            raise_overlays();
+        }
+    }
+
+    if (!ui.amp_inbox_open || !ui.amp_inbox_page) return;
+
+    char heading[64];
+    snprintf(heading, sizeof(heading), "Amp \xC2\xB7 %lu %s",
+             (unsigned long)waiting_count, waiting_count == 1 ? "Needs You" : "Need You");
+    set_label_if_changed(ui.amp_inbox_title, heading);
+
+    /* Responsive grid inside 744x376 body area (x=28, y=84) — zero scrolling for 1..8 threads. */
+    const int area_x = 28, area_y = 84, area_w = BOARD_DISPLAY_WIDTH - 56, area_h = BOARD_DISPLAY_HEIGHT - 102;
+    int cols = waiting_count == 1 ? 1 : waiting_count <= 4 ? 2 : waiting_count <= 6 ? 3 : 4;
+    int rows = (int)((waiting_count + (uint32_t)cols - 1U) / (uint32_t)cols);
+    int gap = cols >= 4 ? 12 : 14;
+    int card_w = waiting_count == 1 ? (area_w * 3 / 4) : (area_w - (cols - 1) * gap) / cols;
