+static void amp_short_age(char *buf, size_t size, uint32_t seconds)
+{
+    if (seconds < 60U) snprintf(buf, size, "%lus", (unsigned long)seconds);
+    else if (seconds < 3600U) snprintf(buf, size, "%lum", (unsigned long)(seconds / 60U));
+    else if (seconds < 86400U) snprintf(buf, size, "%luh", (unsigned long)(seconds / 3600U));
+    else snprintf(buf, size, "%lud", (unsigned long)(seconds / 86400U));
