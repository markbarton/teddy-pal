+static void send_nfc_event(void *argument)
+{
+    uint32_t seq = (uint32_t)(uintptr_t)argument;
+    int fd = -1;
+    char uid[24] = "";
+    xSemaphoreTake(state_lock, portMAX_DELAY);
+    int64_t now = esp_timer_get_time();
+    bool valid = nfc_pending_seq == seq && nfc_pending_uid[0] != '\0' &&
+                 nfc_pending_generation == companion_generation &&
+                 nfc_pending_fd == companion_fd && has_report &&
+                 now - last_frame_us <= PC_TIMEOUT_US;
+    if (valid) {
+        fd = nfc_pending_fd;
+        strlcpy(uid, nfc_pending_uid, sizeof(uid));
+        nfc_pending_uid[0] = '\0';
+    }
+    xSemaphoreGive(state_lock);
+    if (!valid || !(xEventGroupGetBits(events) & CONNECTED_BIT) ||
+        httpd_ws_get_fd_info(monitor_server, fd) != HTTPD_WS_CLIENT_WEBSOCKET) return;
+
+    char payload[96];
+    int length = snprintf(payload, sizeof(payload), "{\"type\":\"buddy.nfc\",\"v\":1,\"uid\":\"%s\"}", uid);
+    if (length <= 0 || length >= (int)sizeof(payload)) return;
+    httpd_ws_frame_t frame = {
+        .type = HTTPD_WS_TYPE_TEXT, .payload = (uint8_t *)payload,
+        .len = (size_t)length, .final = true,
+    };
+    if (httpd_ws_send_frame_async(monitor_server, fd, &frame) != ESP_OK) {
+        httpd_sess_trigger_close(monitor_server, fd);
+    }
+}
+
+bool buddy_network_send_nfc(const char *uid_hex)
+{
+    if (!uid_hex || !uid_hex[0] || strlen(uid_hex) >= sizeof(nfc_pending_uid) ||
+        !state_lock || !events || !monitor_server) return false;
+    if (!(xEventGroupGetBits(events) & CONNECTED_BIT)) return false;
+    xSemaphoreTake(state_lock, portMAX_DELAY);
+    int64_t now = esp_timer_get_time();
+    if (companion_fd < 0 || !has_report || now - last_frame_us > PC_TIMEOUT_US) {
+        xSemaphoreGive(state_lock);
+        return false;
+    }
+    ++nfc_pending_seq;
+    uint32_t seq = nfc_pending_seq;
+    nfc_pending_fd = companion_fd;
+    nfc_pending_generation = companion_generation;
+    strlcpy(nfc_pending_uid, uid_hex, sizeof(nfc_pending_uid));
+    xSemaphoreGive(state_lock);
+    return httpd_queue_work(monitor_server, send_nfc_event, (void *)(uintptr_t)seq) == ESP_OK;
+}
