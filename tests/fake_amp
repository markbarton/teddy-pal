#!/usr/bin/env python3
"""Stand-in `amp` CLI for testing AmpCli mode without hitting Amp's network."""
import json
import os
import sys
from datetime import datetime, timedelta, timezone

if sys.argv[1:4] == ["threads", "list", "--json"]:
    now = datetime.now(timezone.utc)
    if os.environ.get("FAKE_AMP_FAIL"):
        print("not logged in", file=sys.stderr)
        sys.exit(1)
    threads = [
        {
            "id": "T-working",
            "title": "Refactor telemetry parser",
            "updated": (now - timedelta(seconds=30)).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "tree": "file:///Users/dev/clawpal-mac",
            "messageCount": 12,
        },
        {
            "id": "T-recent",
            "title": "Fix invoice sync",
            "updated": (now - timedelta(minutes=25)).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "tree": "file:///home/user/workspace",
            "messageCount": 4,
        },
        {
            "id": "T-old",
            "title": "Old thread from last week",
            "updated": (now - timedelta(days=5)).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "tree": "file:///Users/dev/old-project",
            "messageCount": 2,
        },
    ]
    print(json.dumps(threads))
    sys.exit(0)
sys.exit(2)
